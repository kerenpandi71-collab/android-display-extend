<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/touchpad_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/switch_mode_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/switch_mode"
            style="@style/Widget.Material3.Button.TextButton" />

        <Spinner
            android:id="@+id/mode_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exit"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>

    <!-- Touchpad + scroll strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/touchpad_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="16dp"
            android:background="@drawable/touchpad_background"
            android:orientation="vertical">

            <TextView
                android:id="@+id/touchpad_gesture_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?colorOnSurfaceVariant" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/touchpad_button_hints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="bottom">

                <include layout="@layout/touchpad_hint_row"
                    android:id="@+id/hint_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />

                <include layout="@layout/touchpad_hint_row"
                    android:id="@+id/hint_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />

                <include layout="@layout/touchpad_hint_row"
                    android:id="@+id/hint_night_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />

                <include layout="@layout/touchpad_hint_row"
                    android:id="@+id/hint_rotate_ccw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />

                <include layout="@layout/touchpad_hint_row"
                    android:id="@+id/hint_rotate_cw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/scroll_strip"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/scroll_track_background" />
    </LinearLayout>

    <!-- Bottom action buttons -->
    <LinearLayout
        android:id="@+id/bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            app:icon="@drawable/ic_back"
            app:iconGravity="textStart"
            android:contentDescription="@string/back_button"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart"
            android:contentDescription="@string/home_button"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/night_mode_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            app:icon="@drawable/ic_night_mode"
            app:iconGravity="textStart"
            android:contentDescription="@string/touchpad_hint_night_mode"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rotate_ccw_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            app:icon="@drawable/ic_rotate"
            app:iconGravity="textStart"
            android:contentDescription="@string/rotate"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rotate_cw_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            app:icon="@drawable/ic_rotate_cw"
            app:iconGravity="textStart"
            android:contentDescription="@string/rotate_cw"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />
    </LinearLayout>
</LinearLayout>
