<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/overview_fragment">

    <fragment
        android:id="@+id/overview_fragment"
        android:name="io.github.jqssun.displayextend.OverviewFragment"
        android:label="@string/app_name">
        <action android:id="@+id/action_overview_to_display_detail" app:destination="@id/display_detail_fragment" />
        <action android:id="@+id/action_overview_to_input_binding" app:destination="@id/input_binding_fragment" />
    </fragment>

    <fragment
        android:id="@+id/display_detail_fragment"
        android:name="io.github.jqssun.displayextend.DisplayDetailFragment"
        android:label="@string/display_detail_title">
        <argument
            android:name="display_id"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/input_binding_fragment"
        android:name="io.github.jqssun.displayextend.InputBindingFragment"
        android:label="@string/input_binding_title" />

    <fragment
        android:id="@+id/logs_fragment"
        android:name="io.github.jqssun.displayextend.LogsFragment"
        android:label="@string/tab_logs" />

    <fragment
        android:id="@+id/settings_fragment"
        android:name="io.github.jqssun.displayextend.SettingsFragment"
        android:label="@string/tab_settings" />

    <fragment
        android:id="@+id/input_device_detail_fragment"
        android:name="io.github.jqssun.displayextend.InputDeviceDetailFragment"
        android:label="@string/input_device_detail_title">
        <argument
            android:name="device_id"
            app:argType="integer" />
    </fragment>

</navigation>
